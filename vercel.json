{
  "redirects": [
    {
      "source": "/posing",
      "destination": "https://moveandpose.com/",
      "permanent": true
    },
    {
      "source": "/posing/:path*",
      "destination": "https://moveandpose.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/)(?!@)(?!.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
